# Application
APP_NAME=Ihmom Store API

# PostgreSQL (replace these development placeholders before deployment)
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=ihmom_store
DATABASE_PASSWORD=replace_with_a_strong_database_password
DATABASE_NAME=ihmom_store

# Redis is internal to Docker and required for login/checkout abuse protection.
REDIS_URL=redis://redis:6379/0
LOGIN_RATE_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_PER_ACCOUNT=5
LOGIN_RATE_LIMIT_PER_IP=20
CHECKOUT_RATE_WINDOW_SECONDS=60
CHECKOUT_RATE_LIMIT_PER_IP=30
RATE_LIMIT_KEY_PREFIX=ihmom:rate-limit

# Owner-only WhatsApp notifications. Use a NEW key; never reuse an exposed key.
# Invalid provider configuration pauses the worker, never checkout.
BIRD_NOTIFICATIONS_ENABLED=false
BIRD_API_KEY=
BIRD_API_URL=https://eu1.platform.bird.com/v1/whatsapp/messages
BIRD_ORDER_NOTIFICATION_PHONE=
BIRD_ORDER_TEMPLATE=bird_order_confirmation
BIRD_ORDER_TEMPLATE_LANGUAGE=en
# Optional delivery webhooks; secret returned by Bird when configuring endpoint.
BIRD_WEBHOOK_SECRET=
BIRD_MAX_ATTEMPTS=6
BIRD_POLL_SECONDS=5
BIRD_STATUS_POLL_SECONDS=60
BIRD_STATUS_MAX_CHECKS=48
BIRD_CONNECT_TIMEOUT_SECONDS=5
BIRD_READ_TIMEOUT_SECONDS=10

# Production proxy-only network. Override all four together if this subnet
# overlaps a VPS route/network; never use a wildcard forwarded-header trust.
IHMOM_PROXY_SUBNET=172.30.254.0/29
IHMOM_PROXY_GATEWAY=172.30.254.1
IHMOM_PROXY_API_IP=172.30.254.2
IHMOM_PROXY_UI_IP=172.30.254.3

# JWT signing secret: generate a long random value; never commit the real value
SECRET_KEY=replace_with_a_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=1
ADMIN_SESSION_RETENTION_DAYS=30

# Guest order-history verification (knowledge-based, not proof of ownership)
ORDER_HISTORY_TOKEN_EXPIRE_MINUTES=10
ORDER_HISTORY_RATE_WINDOW_SECONDS=300
ORDER_HISTORY_RATE_LIMIT_PER_IP=10
ORDER_HISTORY_RATE_LIMIT_PER_PHONE=5
ORDER_HISTORY_RATE_LIMIT_GLOBAL=500

# Comma-separated, exact frontend origins. Do not use * with credentials.
CORS_ORIGINS=http://localhost:5173

# Use true behind production HTTPS. "none" also requires Secure cookies.
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

# Container upload location; backed by the uploads_data Docker volume
UPLOAD_ROOT=/app/uploads

# Frontend build/runtime configuration
VITE_DEVELOPMENT_API_URL=http://localhost:8000
VITE_DEVELOPMENT_API_PROXY_TARGET=http://localhost:8000
VITE_DEPLOYMENT_API_URL=http://server
VITE_DEPLOYMENT_API_PROXY_TARGET=http://server
